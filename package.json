{
  "name": "archiflow-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente de auditoría de microservicios con evidencias, Mermaid y Draw.io MCP",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "archiflow": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "doctor": "node src/cli.js doctor",
    "example:fetch": "node scripts/fetch-example.js",
    "example:audit": "node src/cli.js audit --repo examples/quarkus-super-heroes/rest-fights --out runs/rest-fights",
    "mcp:check": "node src/cli.js mcp-check --out runs/mcp-check.json"
  },
  "dependencies": {
    "@drawio/mcp": "1.10.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "dagre-d3-es": "7.0.14",
    "java-parser": "3.0.1",
    "jsdom": "26.1.0",
    "mermaid": "12.2.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
